---
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

interface Props {
	title: string;
	description?: string;
	current?: 'top' | 'about' | 'blog';
}

const { title, description = '冬村未知のポートフォリオサイト', current } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | 冬村未知</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="logo">
				<span class="dot" aria-hidden="true"></span>
				<span>冬村 未知</span>
			</a>
			<nav>
				<a href="/about" class={current === 'about' ? 'is-current' : ''}>ABOUT</a>
				<a href="/blog" class={current === 'blog' ? 'is-current' : ''}>BLOG</a>
				<a href="/#contact">CONTACT</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<span>© 2026 MICHI FUYUMURA</span>
			<span class="mono">BUILT WITH ASTRO</span>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--bg-sub: #fbfaf8;
		--fg: #16150f;
		--fg-sub: #55534d;
		--muted: #8a877c;
		--rule: #ececec;
		--accent: oklch(0.48 0.11 258);
		--maxw: 980px;
		--maxw-prose: 460px;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		background: var(--bg);
		color: var(--fg);
		font-family: 'Zen Kaku Gothic New', sans-serif;
		font-size: 15px;
		line-height: 1.8;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		color: var(--accent);
	}

	h1,
	h2,
	h3 {
		font-weight: 700;
		line-height: 1.5;
		margin: 0;
	}

	p {
		margin: 0;
	}

	.mono {
		font-family: 'JetBrains Mono', monospace;
	}

	.label {
		font-family: 'JetBrains Mono', monospace;
		font-size: 11px;
		letter-spacing: 0.18em;
		color: var(--muted);
	}

	.accent {
		color: var(--accent);
	}
</style>

<style>
	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 24px 56px;
		border-bottom: 1px solid var(--rule);
		max-width: var(--maxw);
		margin: 0 auto;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.logo:hover {
		color: var(--fg);
	}

	.dot {
		width: 9px;
		height: 9px;
		background: var(--accent);
		border-radius: 50%;
		flex-shrink: 0;
	}

	nav {
		display: flex;
		gap: 28px;
		font-size: 12.5px;
		font-weight: 500;
		letter-spacing: 0.1em;
		color: var(--fg-sub);
	}

	nav a.is-current {
		color: var(--accent);
	}

	main {
		max-width: var(--maxw);
		margin: 0 auto;
	}

	.site-footer {
		display: flex;
		justify-content: space-between;
		padding: 22px 56px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 11px;
		color: var(--muted);
		max-width: var(--maxw);
		margin: 0 auto;
	}

	@media (max-width: 768px) {
		.site-header,
		.site-footer,
		main {
			padding-left: 24px;
			padding-right: 24px;
		}

		.site-header {
			flex-wrap: wrap;
			row-gap: 12px;
			padding-top: 18px;
			padding-bottom: 18px;
		}

		nav {
			width: 100%;
			gap: 18px;
			font-size: 12px;
		}

		.site-footer {
			flex-direction: column;
			gap: 6px;
		}
	}

	@media (max-width: 360px) {
		.site-header,
		.site-footer,
		main {
			padding-left: 16px;
			padding-right: 16px;
		}
	}
</style>
