---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.map((p) => ({ slug: p.id, title: p.data.title, date: p.data.date, tag: p.data.tag }));
---

<Base title="Blog" current="blog">
	<section class="blog-index">
		<div class="blog-head">
			<h2>Blog</h2>
			<span class="mono count">{allPosts.length} POSTS</span>
		</div>
		<PostList posts={allPosts} variant="full" />
	</section>
</Base>

<style>
	.blog-index {
		padding: 56px 48px 60px;
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.blog-head {
		display: flex;
		align-items: baseline;
		gap: 16px;
	}

	.blog-head h2 {
		font-size: 28px;
	}

	.count {
		font-size: 11.5px;
		color: var(--muted);
	}

	@media (max-width: 768px) {
		.blog-index {
			padding: 40px 24px 48px;
		}
	}
</style>
